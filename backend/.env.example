# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL de desarrollo: servicio `db` de compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_dev

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000